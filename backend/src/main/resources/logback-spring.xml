<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="study-recommend"/>
    <springProperty scope="context" name="LOG_DIR" source="app.log.dir" defaultValue="logs"/>
    <timestamp key="STARTUP_TS" datePattern="yyyyMMdd-HHmmss"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n"/>
    <property name="LOG_FILE" value="${LOG_DIR}/${APP_NAME}-${STARTUP_TS}.log"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- One dedicated log file per startup -->
    <appender name="STARTUP_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file>
        <append>true</append>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="STARTUP_FILE"/>
    </root>

    <logger name="com.recommend" level="DEBUG"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.apache.hadoop" level="WARN"/>
</configuration>
