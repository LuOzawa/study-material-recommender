# 环境变量示例
# 复制为 .env 或直接在启动前 export。不要提交真实的 .env 文件。

# ---------------------------------------------------------------------------
# 数据库（必填）
# ---------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/recommend_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# JWT（必填）——至少 32 字节，否则应用启动即失败
# 生成方式：openssl rand -base64 48   或   python -c "import secrets;print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---------------------------------------------------------------------------
# CORS 白名单（生产必改）
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Hadoop HDFS（可选，未部署时自动回退本地文件系统）
# ---------------------------------------------------------------------------
HADOOP_URI=hdfs://localhost:9000
HADOOP_USER=hadoop
HADOOP_EXPORT_ENABLED=true
HADOOP_EXPORT_CRON=0 30 2 * * ?
HADOOP_EXPORT_BASE_PATH=/recommend/warehouse
HADOOP_EXPORT_LOCAL_ROOT=./storage/hadoop-export

# ---------------------------------------------------------------------------
# DeepSeek 大模型（可选，不配则 AI 模块返回"未启用"提示）
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_TIMEOUT=60000

# ---------------------------------------------------------------------------
# 文件存储
# ---------------------------------------------------------------------------
HDFS_BASE_PATH=/recommend/materials
LOCAL_STORAGE_ROOT=./storage

# ---------------------------------------------------------------------------
# 推荐引擎（Python 脚本路径与返回条数）
# ---------------------------------------------------------------------------
RECOMMENDATION_SCRIPT=../recommendation/run_recommendation.py
RECOMMENDATION_TOP_N=10

# ---------------------------------------------------------------------------
# 运行时日志（logback 读取 app.log.dir，缺省会落在进程工作目录 ./logs）
# ---------------------------------------------------------------------------
APP_LOG_DIR=./logs
